<?xml version="1.0" encoding="utf-8"?>
<!--
  Tablets. The phone layout stacks everything and scrolls; on a tablet that left the bottom half
  of the screen empty and the side column blank on explanation steps. Here the screen is divided
  once and both halves are made to fill it: the picture grows to take whatever height is going,
  and the narration column always has the text in it, so neither side is ever empty.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_card_alt">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lesson_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ بازگشت"
            android:textColor="@color/teal_dark"
            android:textStyle="bold"
            android:padding="6dp"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/lesson_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/lesson_step_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11.5sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lesson_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </LinearLayout>

    <!-- the whole middle of the screen; both columns stretch to fill it -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:baselineAligned="false">

        <!-- picture side (the start side, so on the right in RTL) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:orientation="vertical"
            android:layout_marginEnd="8dp"
            android:paddingBottom="76dp">

            <FrameLayout
                android:id="@+id/lesson_stage_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="12dp"
                android:background="@drawable/bg_card_white">

                <com.hoohoofarsi.app.ui.LessonStageView
                    android:id="@+id/lesson_stage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="260dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/lesson_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="14dp"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_card_teal" />
        </LinearLayout>

        <!-- talking side: narration, then whatever the step asks the child to do -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:padding="14dp"
                        android:background="@drawable/bg_card_orange">

                        <TextView
                            android:id="@+id/lesson_replay"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:gravity="center"
                            android:text="▶"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_circle_teal" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/lesson_phase"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11.5sp"
                                android:textStyle="bold"
                                android:textColor="@color/orange_text" />

                            <TextView
                                android:id="@+id/lesson_say"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textSize="15.5sp"
                                android:lineSpacingExtra="7dp"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lesson_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal" />
                </LinearLayout>
            </ScrollView>

            <!-- kept on this side so the owl's corner at the bottom of the picture stays clear -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layoutDirection="rtl"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/lesson_prev"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:padding="13dp"
                    android:text="‹ گام قبل"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_help_button" />

                <TextView
                    android:id="@+id/lesson_next"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="13dp"
                    android:text="گام بعد ›"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_help_button" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
