<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the narration clips and the worksheets are fetched from the teacher's host -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Announcements: a new worksheet, a new chapter, the online exam. Asked for only when there
      is actually a notice to show, never on a first launch (see ui/Announcements).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The exam countdown is five alarms, and AlarmManager forgets every alarm on a reboot. A
      phone restarted on the morning of the exam would otherwise never ring.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      News with the app closed. Without being let off battery optimisation the system may hold
      the background check back for hours. Asked once, and only when there is news to deliver
      (see ui/Announcements.askBackgroundOnce); the parent panel can ask again.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- the subscription is bought through Bazaar's own payment screen -->
    <uses-permission android:name="com.farsitel.bazaar.permission.PAY_THROUGH_BAZAAR" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      Since Android 11 an app cannot even see another package unless it says so here. Without
      this the bind to Bazaar fails with no error worth reading, and every purchase looks like a
      connection problem.
    -->
    <queries>
        <package android:name="com.farsitel.bazaar" />
    </queries>

    <application
        android:name=".HooHooApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.HooHooFarsi">

        <!--
          Lets «باز کن» pass a downloaded worksheet to a PDF reader. Since Android 7 a file://
          Uri handed to another app throws, so the sheet goes out as a content:// Uri instead,
          read-only and for that one file.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.sheets"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.HooHooFarsi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          A tapped notice with a link: opens the link without opening the app. Its own empty
          task affinity and no history, so it never shows in recents or pulls the app forward.
        -->
        <activity
            android:name=".ui.NoticeLinkActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- «نیم ساعت مانده تا آزمون» and the four after it -->
        <receiver
            android:name=".work.ExamAlarm"
            android:exported="false" />

        <receiver
            android:name=".work.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- the background news check that gets through Doze (see work/NoticeAlarm) -->
        <receiver
            android:name=".work.NoticeAlarm"
            android:exported="false" />
    </application>

</manifest>
