{
  "name": "hoohoo-voice-studio",
  "version": "1.0.0",
  "private": true,
  "description": "استودیوی صداگذاری هوهو — متن را از audio_manifest.txt می‌خواند و با آواشو تکی ضبط می‌کند",
  "type": "module",
  "scripts": {
    "start": "vite build && node server/index.js",
    "server": "node server/index.js",
